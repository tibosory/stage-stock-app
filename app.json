{
  "expo": {
    "name": "CATRACK Pro",
    "slug": "stage-stock",
    "scheme": "stagestock",
    "version": "1.0.35",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vellein.stagestock",
      "infoPlist": {
        "CFBundleDisplayName": "CATRACK Pro",
        "NSCameraUsageDescription": "Nécessaire pour scanner les QR codes et photographier le matériel",
        "NSPhotoLibraryUsageDescription": "Nécessaire pour accéder aux photos du matériel",
        "NFCReaderUsageDescription": "Nécessaire pour lire et écrire les puces NFC du matériel",
        "NSLocalNetworkUsageDescription": "Permet de joindre un serveur CATRACK Pro sur le réseau Wi‑Fi local (adresse IP du PC).",
        "UIBackgroundModes": [
          "fetch"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090B"
      },
      "package": "com.vellein.stagestock",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "stagestock",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "stagestock",
              "host": "pair"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "queries": [
        {
          "intent": {
            "action": "VIEW",
            "category": [
              "BROWSABLE"
            ],
            "data": {
              "scheme": "https"
            }
          }
        },
        {
          "intent": {
            "action": "VIEW",
            "category": [
              "BROWSABLE"
            ],
            "data": {
              "scheme": "http"
            }
          }
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.NFC",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 31
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Nécessaire pour scanner les QR codes et photographier le matériel"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nécessaire pour accéder aux photos du matériel",
          "cameraPermission": "Nécessaire pour photographier le matériel"
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "gradleProperties": {
              "reactNativeArchitectures": "arm64-v8a",
              "org.gradle.parallel": "true",
              "org.gradle.caching": "true",
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=512m"
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0b1c50f3-1781-4d5e-8b21-841b8ecfb802"
      },
      "consumerApp": true,
      "v1Lan": true,
      "installerGitHubRepo": "tibosory/stage-stock-app",
      "privacyPolicyUrl": "",
      "termsOfServiceUrl": ""
    },
    "runtimeVersion": "1.0.35",
    "updates": {
      "enabled": false
    },
    "owner": "tibo1980"
  }
}
